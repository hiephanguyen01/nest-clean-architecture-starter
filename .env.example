NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://app:replace-me@localhost:5432/app?schema=public
POSTGRES_USER=app
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=app
POSTGRES_PORT=5432

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-access
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters-refresh
JWT_REFRESH_EXPIRES_IN_SECONDS=604800
JWT_ISSUER=nest-clean-architecture-starter
JWT_AUDIENCE=nest-clean-architecture-api
REFRESH_TOKEN_HASH_SECRET=replace-with-at-least-32-random-characters-hmac

CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
TRUST_PROXY=false
LOG_LEVEL=info
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100
REQUEST_BODY_LIMIT=1mb
